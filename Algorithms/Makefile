#Makefile for the algorithms

Counting: Counting.cpp
	g++ Counting.cpp -o Counting

Heap: Heap.cpp
	g++ Heap.cpp -o Heap

Insertion: Insertion.cpp
	g++ Insertion.cpp -o Insertion

Merge: Merge.cpp
	g++ Merge.cpp -o Merge

Quick: Quick.cpp
	g++ Quick.cpp -o Quick

Selection: Selection.cpp
	g++ Selection.cpp -o Selection

clean:
	find . -type f -executable -exec rm '{}' \;
